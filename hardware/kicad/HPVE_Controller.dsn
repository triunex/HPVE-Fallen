
(PCB "HPVE_Controller"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version 10.0.7)
    (generated_by_freeroute)
  )
  (resolution um 10)
  (structure
    (boundary
      (rect pcb 45900.0 -140100.0 170100.0 -45900.0)
    )
    (boundary
      (polygon signal 0
        46000.0 -140000.0
        170000.0 -140000.0
        170000.0 -46000.0
        46000.0 -46000.0
      )
    )
    (snap_angle 
      fortyfive_degree
    )
    (via "Via[0-1]_800:400_um" "Via[0-1]_800:400_um")
    (control
      (via_at_smd off)
    )
    (rule
      (width 250.0)
      (clear 152.4)
      (clear 125.0 (type smd_to_turn_gap))
      (clear 38.0 (type smd-smd))
    )
    (layer F.Cu
      (type signal)
    )
    (layer B.Cu
      (type signal)
    )
    (autoroute_settings
      (fanout off)
      (autoroute on)
      (postroute on)
      (vias on)
      (via_costs 50)
      (plane_via_costs 5)
      (start_ripup_costs 100)
      (start_pass_no 12)
      (layer_rule F.Cu
        (active on)
        (preferred_direction horizontal)
        (preferred_direction_trace_costs 1.0)
        (against_preferred_direction_trace_costs 2.3)
      )
      (layer_rule B.Cu
        (active on)
        (preferred_direction vertical)
        (preferred_direction_trace_costs 1.0)
        (against_preferred_direction_trace_costs 1.8)
      )
    )
  )
