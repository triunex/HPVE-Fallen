
(rules PCB HPVE_Tile_16Ch
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 11)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule In1.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule In2.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
  )
  (rule
    (width 250.0)
    (clear 150.0)
    (clear 125.0 (type smd_to_turn_gap))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (via 
    "Via[0-3]_800:400_um" "Via[0-3]_800:400_um" default
  )
  (via 
    "Via[0-3]_600:300_um-kicad_default" "Via[0-3]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-3]_800:400_um-kicad_default" "Via[0-3]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-3]_600:300_um-Power" "Via[0-3]_600:300_um" default
  )
  (via 
    "Via[0-3]_800:400_um-Power" "Via[0-3]_800:400_um" default
  )
  (via_rule
    default "Via[0-3]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_600:300_um-kicad_default"
  )
  (via_rule
    Power "Via[0-3]_800:400_um-Power"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "SPI_MOSI_IN" "SPI_MOSI" "SPI_SCK_IN" "SPI_SCK" "SPI_LATCH_IN" "SPI_LATCH" "SPI_MOSI_CASCADE" "SPI_MOSI_OUT"
    "SIG_1" "SIG_2" "SIG_3" "SIG_4" "SIG_5" "SIG_6" "SIG_7" "SIG_8"
    "SIG_9" "SIG_10" "SIG_11" "SIG_12" "SIG_13" "SIG_14" "SIG_15" "SIG_16"
    "DRV_1" "DRV_2" "DRV_3" "DRV_4" "DRV_5" "DRV_6" "DRV_7" "DRV_8"
    "DRV_9" "DRV_10" "DRV_11" "DRV_12" "DRV_13" "DRV_14" "DRV_15" "DRV_16"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 250.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    GND +12V +5V
    (clearance_class default)
    (via_rule Power)
    (rule
      (width 500.0)
    )
    (layer_rule In1.Cu
      (rule 
        (width 0.0) 
      )
    )
    (layer_rule In2.Cu
      (rule 
        (width 0.0) 
      )
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)